# 复制为 .env 后填入 key。两组任选其一即可运行，都填则用 PROVIDER 指定的那组。
# 变量名刻意用 OPENAI_ / ANTHROPIC_ 而非厂商专名：任何兼容这两种协议的服务都能直接跑。

# 用哪一组：openai | anthropic
PROVIDER=openai

# ---- OpenAI 兼容协议（DeepSeek / Kimi / 通义 / 智谱 / vLLM 等都走这里）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# ---- Anthropic 协议 ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# ---- 运行参数 ----
TEMPERATURE=0.2
MAX_RETRIES=2
REQUEST_TIMEOUT=600
MAX_TOKENS=128000
